{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/*"],

      "#env": ["./src/env.ts"],
      "#app/*": ["./src/app/*"],
      "#app/routes/*": ["./src/app/(routes)/*"],
      "#app/layouts/*": ["./src/app/(layouts)/*"],
      "#features/*": ["./src/features/*"],

      "#assets": ["./src/assets"],
      "#assets/*": ["./src/assets/*"],
      "#components": ["./src/components"],
      "#components/*": ["./src/components/*"],
      "#types": ["./src/types"],
      "#types/*": ["./src/types/*"],
      "#utils": ["./src/utils"],
      "#utils/*": ["./src/utils/*"],
      "#lib": ["./src/lib"],
      "#lib/*": ["./src/lib/*"],
      "#hooks": ["./src/hooks"],
      "#hooks/*": ["./src/hooks/*"],
    },
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
  ],
  "exclude": ["node_modules"],
}
