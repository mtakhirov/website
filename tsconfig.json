{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "~/*": ["./src/*"],

      "#env": ["./src/env.ts"],
      "#proxy": ["./src/proxy.ts"],
      "#app/*": ["./src/app/*"],
      "#assets/*": ["./src/assets/*"],
      "#components/*": ["./src/components/*"],
      "#config/*": ["./src/config/*"],
      "#data/*": ["./src/data/*"],
      "#i18n": ["./src/i18n"],
      "#i18n/*": ["./src/i18n/*"],
      "#lib/*": ["./src/lib/*"],
      "#types": ["./src/types.ts"],
      "#utils": ["./src/utils"],
      "#utils/*": ["./src/utils/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
